# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional. Enables YouTube Data API search for lesson and study-planner recommendations.
YOUTUBE_API_KEY="MY_YOUTUBE_API_KEY"

# Optional deployment metadata. The current app uses the browser origin for
# auth redirects and relative paths for API requests; it does not read APP_URL.
APP_URL="MY_APP_URL"

# Supabase client configuration (public anon/publishable key)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
